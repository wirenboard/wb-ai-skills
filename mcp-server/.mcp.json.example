{
  "mcpServers": {
    "wiren-board": {
      "command": "bun",
      "args": ["run", "/ABSOLUTE/PATH/TO/wb-ai-skills/mcp-server/src/index.ts"],
      "env": {
        "WB_SSH_USER": "root",
        "WB_SSH_PASSWORD": "wirenboard",
        "_comment_WB_CHART_FORMAT": "Set to \"svg\" if your client is a TUI (Claude Code CLI, opencode TUI) and doesn't render Mermaid blocks — wb_history_chart will then write an SVG file to /tmp/wb-charts/ instead. Leave unset for browser clients (default: inline Mermaid).",
        "WB_CHART_FORMAT": "svg"
      }
    }
  }
}
